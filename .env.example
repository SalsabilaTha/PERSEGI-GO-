# Salin file ini menjadi .env lalu isi nilainya (lihat docs/SETUP_AKUN.md).
# File .env TIDAK BOLEH di-upload ke GitHub.

# development = boleh "Masuk mode uji" tanpa Supabase; production = wajib Supabase
APP_ENV=development

# Kunci acak panjang untuk Flask
FLASK_SECRET_KEY=ganti-dengan-teks-acak-panjang

# --- Supabase (kosongkan saat belum punya; aplikasi memakai mode uji lokal) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWT secret (Project Settings -> JWT). Dipakai bila proyek masih memakai token HS256.
SUPABASE_JWT_SECRET=

# Koneksi database Supabase (Connect -> Session pooler).
# Kosong = memakai SQLite lokal di folder instance/ (hanya untuk pengembangan).
DATABASE_URL=

# --- Tutor AI DeepSeek (https://platform.deepseek.com -> API keys) ---
# Kosong = Tutor AI memakai petunjuk bawaan (tanpa AI). Kunci ini RAHASIA, hanya untuk server.
DEEPSEEK_API_KEY=
# Opsional: nama model dan alamat API (biarkan kosong untuk nilai bawaan)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
